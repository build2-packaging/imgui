impl_libs = # Implementation libs.
import impl_libs += libimgui-platform-glfw%lib{imgui-platform-glfw} \
                    libimgui-render-vulkan%lib{imgui-render-vulkan}

# Direct driver loading on macOS: build MoltenVK with the example but do
# not link it (vk* would collide with the loader). lib{mvk-direct-util}
# dlopens MVK_DYLIB_PATH at runtime. See libmoltenvk/PACKAGE-README.md.
#
import? [metadata, rule_hint=cxx.link] dylib = libmoltenvk%libs{MoltenVK}
import? util = libmoltenvk%lib{mvk-direct-util}

exe{example_glfw_vulkan}: cxx{main} $impl_libs
exe{example_glfw_vulkan}: {hxx mm}{macos_surface}: include = ($dylib != [null])
exe{example_glfw_vulkan}: $dylib:                  include = ($dylib != [null] ? adhoc : false)
exe{example_glfw_vulkan}: $util:                   include = ($util != [null])

if ($dylib != [null])
{
  cxx.poptions += "-DMVK_DYLIB_PATH=\"$posix_string($($dylib: libmoltenvk.dylib_path))\""
  cxx.libs += -framework Cocoa -framework QuartzCore
}

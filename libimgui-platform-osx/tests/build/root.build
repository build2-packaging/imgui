# Apple SDK headers use enum arithmetic that C++26 makes ill-formed.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx
using cxx.objcxx

hxx{*}: extension = h
cxx{*}: extension = cpp

# Every exe{} in this subproject is by default a test.
#
exe{*}: test = true

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

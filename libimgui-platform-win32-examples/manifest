# Upstream's DirectX 12 example calls struct-returning COM methods (e.g.
# GetCPUDescriptorHandleForHeapStart()) the MSVC way, while DirectX-Headers
# declares them with an out pointer for non-MSVC compilers.
#
build-exclude: **mingw** ; Upstream DirectX 12 example is MSVC-only.
build-exclude: windows**-static** ; Requires shared (libvulkan-loader).
build-include: windows**
build-exclude: ** ; Only supported on Windows.

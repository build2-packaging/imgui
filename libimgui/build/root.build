# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = h
cxx{*}: extension = cpp

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

# Upstream leaves these commented out in imconfig.h.
# FreeType selects that font loader instead of stb_truetype.
# WCHAR32 makes ImWchar 32-bit, so the macro is exported to consumers.
#
config [bool] config.libimgui.freetype ?= false
config [bool] config.libimgui.use_wchar32 ?= false

./: hxx{imgui_freetype}@./

# Only the enabled FreeType build installs this header. The installed
# path matches the upstream include <misc/freetype/imgui_freetype.h>.
# install.subdirs is set on hxx{*} in include/, and from this nested
# scope that would repeat misc/freetype/.
#
hxx{imgui_freetype}@./:
{
  install         = ($config.libimgui.freetype ? include/misc/freetype/ : false)
  install.subdirs = false
}

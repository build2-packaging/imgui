# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

# Apple SDK headers use enum arithmetic that C++26 makes ill-formed.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx
using cxx.objcxx

hxx{*}: extension = h
cxx{*}: extension = cpp
